// Cloudflare Worker configuration for the Crepe Beirut website and admin.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crepe-beirut",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The database for menu content and orders. On the first deploy Wrangler creates it
  // automatically and binds it as DB. No SQL needed: the tables create themselves.
  "d1_databases": [
    { "binding": "DB", "database_name": "crepe-beirut" }
  ],
  "observability": { "enabled": true }
}
