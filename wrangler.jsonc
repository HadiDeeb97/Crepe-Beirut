// Cloudflare Worker configuration for the Crepe Beirut website and admin.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crepe-beirut",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  // The database for menu content and orders. On the first deploy Wrangler creates a D1
  // database named "crepe-beirut" (or reuses one with that name) and binds it as CREPE_DB.
  // No SQL needed: the tables create themselves.
  "d1_databases": [
    { "binding": "CREPE_DB", "database_name": "crepe-beirut" }
  ],
  // Keep variables added in the Cloudflare dashboard when deploying from GitHub.
  // (Secrets such as ADMIN_PASSWORD are always kept.)
  "keep_vars": true,
  "observability": { "enabled": true }
}
